{
  "name": "@scholar-club/pdf-viewer",
  "version": "0.1.0",
  "description": "零 LLM 依赖、可复用的 PDF 查看器组件（pdfjs-dist 6 直连）",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify.mjs",
    "demo": "pnpm --filter @scholar-club/pdf-viewer-demo dev",
    "e2e": "node scripts/e2e-smoke.mjs",
    "e2e:serve": "pnpm --filter @scholar-club/pdf-viewer-demo dev --port 5180"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "pdfjs-dist": "^6.4.299"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20"
  }
}
