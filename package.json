{
  "name": "@scholar-space/pdf-viewer",
  "version": "0.1.0",
  "description": "零 LLM 依赖、可复用的 PDF 查看器组件（pdfjs-dist 6 直连）",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./editor": {
      "import": {
        "types": "./dist/editor.d.ts",
        "default": "./dist/editor.js"
      },
      "require": {
        "types": "./dist/editor.d.cts",
        "default": "./dist/editor.cjs"
      }
    },
    "./dialog": {
      "import": {
        "types": "./dist/dialog.d.ts",
        "default": "./dist/dialog.js"
      },
      "require": {
        "types": "./dist/dialog.d.cts",
        "default": "./dist/dialog.cjs"
      }
    },
    "./icons": {
      "import": {
        "types": "./dist/icons.d.ts",
        "default": "./dist/icons.js"
      },
      "require": {
        "types": "./dist/icons.d.cts",
        "default": "./dist/icons.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./themes.css": "./dist/themes.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:build": "pnpm build && pnpm --filter @scholar-space/pdf-viewer-demo build",
    "e2e": "node scripts/e2e-smoke.mjs",
    "e2e:text": "node scripts/e2e-text-layer.mjs",
    "e2e:panels": "node scripts/e2e-panels.mjs",
    "e2e:links": "node scripts/e2e-links.mjs",
    "e2e:selection": "node scripts/e2e-selection-align.mjs",
    "e2e:selection:stable": "node scripts/e2e-selection-stability.mjs",
    "e2e:selection:popover": "node scripts/e2e-selection-popover.mjs",
    "e2e:selection:shape": "node scripts/e2e-selection-shape.mjs",
    "e2e:highlight": "node scripts/e2e-highlight.mjs",
    "e2e:zoom": "node scripts/e2e-zoom.mjs",
    "e2e:search": "node scripts/e2e-search-highlight.mjs",
    "e2e:thumbnail": "node scripts/e2e-thumbnail.mjs",
    "e2e:all": "node scripts/e2e-all.mjs",
    "e2e:serve": "pnpm --filter @scholar-space/pdf-viewer-demo dev",
    "size": "size-limit",
    "publint": "publint",
    "attw": "attw --pack",
    "release:check": "pnpm size && pnpm publint && pnpm attw",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.4",
    "@changesets/cli": "^3.0.3",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-color": "^3.34.0",
    "@tiptap/extension-highlight": "^3.34.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/extension-text-style": "^3.34.0",
    "@tiptap/extension-underline": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "^31.0.1",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.65.0",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "pdfjs-dist": "^6.4.299"
  },
  "peerDependencies": {
    "@tiptap/core": ">=3.0.0",
    "@tiptap/extension-color": ">=3.0.0",
    "@tiptap/extension-highlight": ">=3.0.0",
    "@tiptap/extension-link": ">=3.0.0",
    "@tiptap/extension-placeholder": ">=3.0.0",
    "@tiptap/extension-text-style": ">=3.0.0",
    "@tiptap/extension-underline": ">=3.0.0",
    "@tiptap/react": ">=3.0.0",
    "@tiptap/starter-kit": ">=3.0.0",
    "pdf-lib": ">=1.17.0",
    "react": ">=18.0.0 <20",
    "react-dom": ">=18.0.0 <20"
  },
  "peerDependenciesMeta": {
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/extension-color": {
      "optional": true
    },
    "@tiptap/extension-highlight": {
      "optional": true
    },
    "@tiptap/extension-link": {
      "optional": true
    },
    "@tiptap/extension-placeholder": {
      "optional": true
    },
    "@tiptap/extension-text-style": {
      "optional": true
    },
    "@tiptap/extension-underline": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "pdf-lib": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hidari123/scholar-pdf-viewer.git"
  },
  "homepage": "https://github.com/hidari123/scholar-pdf-viewer#readme",
  "bugs": {
    "url": "https://github.com/hidari123/scholar-pdf-viewer/issues"
  },
  "author": {
    "name": "hidari",
    "url": "https://github.com/hidari123"
  },
  "keywords": [
    "pdf",
    "pdf-viewer",
    "react",
    "pdfjs",
    "viewer",
    "annotation",
    "highlight",
    "scholar",
    "paper"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
